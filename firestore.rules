        match /{subcollection}/{nested=**} {
          allow read: if subcollection != "tasks" && permitted("20");
          allow write: if subcollection != "tasks" && (canEditJob(getAfter(jobPath(jobId)).data)
            || (subcollection in ["plans", "laborLineItems", "plannedServiceStops"] && permitted("72"))
            || (subcollection == "history" && get(jobPath(jobId)) == null && getAfter(jobPath(jobId)).data.get("createdByUserId", "") == request.auth.uid)
            || (subcollection == "comments" && permitted("20") && request.resource.data.get("userId", "") == request.auth.uid));
        }
      }
      match /jobTemplates/{templateId} {
        allow read: if permitted("20") || canManageJobTemplates() || permitted("22") || permitted("23") || permitted("27") || permitted("29") || permitted("31");
        allow write: if canManageJobTemplates();
        match /{scope=**} {
          allow read: if permitted("20") || canManageJobTemplates() || permitted("22") || permitted("23") || permitted("27") || permitted("29") || permitted("31");
          allow write: if canManageJobTemplates();
        }
      }
      match /salesCatalogItems/{catalogItemId} {
        // Shared pickers read by company path, including legacy items without companyId.
        allow read: if companyBillingPermission(companyId, [
          "20", "24", "28", "72", "400", "404", "430", "432", "434", "628", "920"
        ]);
        // Job/template planners can add a new reusable service; billing managers
        // control subsequent edits, archiving, and deletion of shared services.
        allow create: if companyBillingPermission(companyId, ["24", "28", "72", "404", "920"])
          && request.resource.data.get("companyId", "") == companyId;
        allow update: if canManageCompanyBilling(companyId)
          && request.resource.data.get("companyId", "") == companyId;
        allow delete: if canManageCompanyBilling(companyId);
      }
      match /{companyCollection}/{document=**} {
        allow read: if !(companyCollection in ["stopData", "activeRoutes", "activeRouteLogs", "activeRouteLocations", "settings", "roles", "companyUsers", "todoItems", "todoBoards", "serviceStops", "workOrders", "jobTemplates", "technicianRates", "technicianPayLineItems", "technicianPayStatements", "paySettings", "workLogs", "shifts", "workOffers", "payChangeRequests", "routeMoveRequests", "adminNotes"]) && collectionPermission(companyCollection, 0);
        allow create: if !(companyCollection in ["stopData", "activeRoutes", "activeRouteLogs", "activeRouteLocations", "settings", "roles", "companyUsers", "todoItems", "todoBoards", "serviceStops", "workOrders", "jobTemplates", "technicianRates", "technicianPayLineItems", "technicianPayStatements", "paySettings", "workLogs", "shifts", "workOffers", "payChangeRequests", "routeMoveRequests", "adminNotes"]) && collectionPermission(companyCollection, 1);
        allow update: if !(companyCollection in ["stopData", "activeRoutes", "activeRouteLogs", "activeRouteLocations", "settings", "roles", "companyUsers", "todoItems", "todoBoards", "serviceStops", "workOrders", "jobTemplates", "technicianRates", "technicianPayLineItems", "technicianPayStatements", "paySettings", "workLogs", "shifts", "workOffers", "payChangeRequests", "routeMoveRequests", "adminNotes"]) && collectionPermission(companyCollection, 2);
        allow delete: if !(companyCollection in ["stopData", "activeRoutes", "activeRouteLogs", "activeRouteLocations", "settings", "roles", "companyUsers", "todoItems", "todoBoards", "serviceStops", "workOrders", "jobTemplates", "technicianRates", "technicianPayLineItems", "technicianPayStatements", "paySettings", "workLogs", "shifts", "workOffers", "payChangeRequests", "routeMoveRequests", "adminNotes"]) && collectionPermission(companyCollection, 3);
      }
      match /adminNotes/{noteId} { allow read, write: if isDripDropAdmin(); }

    }

    match /companyUserPerformanceReviews/{companyId}/companyUsers/{companyUserId}/reviews/{reviewId} {
      allow read: if canReadCompanyUserPerformanceReviews(companyId)
        || canReadOwnVisiblePerformanceReview(companyId, companyUserId);
      allow create: if canWriteCompanyUserPerformanceReviews(companyId)
        && request.resource.data.companyId == companyId
        && request.resource.data.companyUserId == companyUserId;
      allow update: if canWriteCompanyUserPerformanceReviews(companyId)
        && resource.data.companyId == companyId
        && resource.data.companyUserId == companyUserId
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.companyUserId == resource.data.companyUserId;
      allow delete: if canWriteCompanyUserPerformanceReviews(companyId)
        && resource.data.companyId == companyId
        && resource.data.companyUserId == companyUserId;
    }

    match /invites/{inviteId} {
      allow read: if signedIn()
        && (
          (resource.data.email is string && resource.data.email == request.auth.token.email)
          || (resource.data.userId is string && resource.data.userId == request.auth.uid)
          || (resource.data.companyId is string && hasCompanyAccess(resource.data.companyId))
        );
      allow create, update, delete: if false;
    }

    match /chats/{chatId} {
      allow read: if isDripDropAdmin() || canReadChatData(resource.data);
      allow create: if signedIn() && chatParticipant(request.resource.data);
      allow update: if canReadChatData(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessage", "lastMessageKind", "lastConversationLink", "mostRecentChat", "updatedAt", "userWhoHaveNotRead", "companyIdsWhoHaveNotRead", "readByUserIds", "unreadMessages"
        ]);
      allow delete: if isDripDropAdmin();
    }
    match /messages/{messageId} {
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid
        && (canReadChatById(request.resource.data.chatId) || canReadChatByIdAfter(request.resource.data.chatId));
      allow read: if signedIn() && canReadChatById(resource.data.chatId);
      allow update: if signedIn() && canReadChatById(resource.data.chatId)
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readByUserIds", "readAt"])
          || (resource.data.senderId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["senderId", "senderCompanyId", "chatId", "receiverId", "receiverCompanyId", "dateSent"])));
      allow delete: if signedIn() && canReadChatById(resource.data.chatId) && resource.data.senderId == request.auth.uid;
    }

    match /homeownerServiceRequests/{requestId} {
      allow read, delete: if isPersonalOrCompanyData(resource.data);
      allow update: if isPersonalOrCompanyData(resource.data) && preservesHomeownerIdentity();
      allow create: if isPersonalOrCompanyData(request.resource.data);
    }

    match /homeownerRepairRequests/{requestId} {
      allow read, delete: if isPersonalOrCompanyData(resource.data);
      allow update: if isPersonalOrCompanyData(resource.data) && preservesHomeownerIdentity();
      allow create: if signedIn() && hasCompanyAccess(request.resource.data.get('companyId', ''));
    }

    match /homeownerRepairRequests/{requestId}/comments/{commentId} {
      allow read, update, delete: if isPersonalOrCompanyData(resource.data);
      allow create: if isPersonalOrCompanyData(request.resource.data);
    }

    match /customerCompanyRelationships/{relationshipId} {
      allow read: if isPersonalOrCompanyData(resource.data);
      allow write: if false;
    }

    match /homeownerServiceLocations/{locationId} {
      allow read, delete: if isPersonalOrCompanyData(resource.data);
      allow update: if isPersonalOrCompanyData(resource.data) && preservesHomeownerIdentity();
      allow create: if isPersonalOrCompanyData(request.resource.data);
    }

    match /homeownerBodiesOfWater/{bodyOfWaterId} {
      allow read, delete: if isPersonalOrCompanyData(resource.data);
      allow update: if isPersonalOrCompanyData(resource.data) && preservesHomeownerIdentity();
      allow create: if isPersonalOrCompanyData(request.resource.data);
    }

    match /homeownerEquipment/{equipmentId} {
      allow read, delete: if isPersonalOrCompanyData(resource.data);
      allow update: if isPersonalOrCompanyData(resource.data) && preservesHomeownerIdentity();
      allow create: if isPersonalOrCompanyData(request.resource.data);
    }

    match /homeownerServiceStops/{serviceStopId} {
      allow read: if isPersonalOrCompanyData(resource.data);
      allow delete: if signedIn() && resource.data.get('userId', '') == request.auth.uid;
      allow create, update: if false;
    }

    match /homeownerStopData/{stopDataId} {
      allow read, update, delete: if isPersonalOrCompanyData(resource.data);
      allow create: if isPersonalOrCompanyData(request.resource.data);
    }

    match /stopData/{stopDataId} {
      allow read, update, delete: if isPersonalOrCompanyData(resource.data);
      allow create: if isPersonalOrCompanyData(request.resource.data);
    }

    match /linkedInvite/{inviteId} {
      allow read, update, delete: if isPersonalOrCompanyData(resource.data);
      allow create: if isPersonalOrCompanyData(request.resource.data);
    }

    match /contracts/{contractId} {
      allow read, update, delete: if isPersonalOrCompanyData(resource.data);
      allow create: if isPersonalOrCompanyData(request.resource.data);
    }

    match /recurringContracts/{contractId} {
      allow read, update, delete: if isPersonalOrCompanyData(resource.data);
      allow create: if isPersonalOrCompanyData(request.resource.data);
    }

    match /laborContracts/{contractId} {
      allow read, update, delete: if isPersonalOrCompanyData(resource.data);
      allow create: if isPersonalOrCompanyData(request.resource.data);
    }

    match /serviceStops/{serviceStopId} {
      allow read, update, delete: if isPersonalOrCompanyData(resource.data);
      allow create: if isPersonalOrCompanyData(request.resource.data);
    }

    match /workOrders/{workOrderId} {
      allow read, update, delete: if isPersonalOrCompanyData(resource.data);
      allow create: if isPersonalOrCompanyData(request.resource.data);
    }

    match /invoices/{invoiceId} {
      allow read, update, delete: if isPersonalOrCompanyData(resource.data);
      allow create: if isPersonalOrCompanyData(request.resource.data);
    }

    match /salesAgreements/{agreementId} {
      allow read: if canReadSalesAgreementRecord(resource.data);
      allow create: if canCreateSalesAgreementRecord(request.resource.data);
      allow update: if canUpdateSalesAgreementRecord(resource.data) && preservesSalesIdentity();
      allow delete: if canDeleteSalesAgreementRecord(resource.data);
    }

    match /salesBillingProfiles/{billingProfileId} {
      allow read: if canReadSalesRecord(resource.data);
      allow create: if canCompanyWriteSalesRecord(request.resource.data);
      allow update: if canCompanyWriteSalesRecord(resource.data) && preservesSalesIdentity() && preservesStripeBillingFields();
      allow delete: if false;
    }

    match /salesBillingSubscriptions/{billingSubscriptionId} {
      allow read: if canReadSalesRecord(resource.data);
      allow create: if canCompanyWriteSalesRecord(request.resource.data)
        && request.resource.data.get("stripeSubscriptionId", "") in ["", null]
        && request.resource.data.get("stripeCustomerId", "") in ["", null]
        && !request.resource.data.keys().hasAny(["checkoutAttemptId", "checkoutHold", "checkoutVersion", "checkoutSessionId", "checkoutCustomerData", "billingReviewRequired", "stripePricingSnapshotHash", "checkoutCancellationRequested", "checkoutCancellationId", "checkoutCancellationStatus", "billingEndAt", "stripeCancelAt"])
        && request.resource.data.get("autopayEnabled", false) != true;
      allow update: if canCompanyWriteSalesRecord(resource.data) && preservesSalesIdentity() && preservesStripeBillingFields()
        && ((resource.data.get("stripeSubscriptionId", "") in ["", null] && resource.data.get("checkoutHold", false) != true)
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["status", "amountCents", "lineItems", "currency", "interval", "intervalCount", "currentPeriodStart", "currentPeriodEnd", "cancelAtPeriodEnd", "applicationFeePercent", "taxAmountCents", "discountAmountCents", "billingTimeZone", "billingAnchorDay", "billingSendAnchorDay", "manualBillingNextPeriodStart", "manualBillingNextPeriodEnd", "manualBillingNextInvoiceAt"]));
      allow delete: if canCompanyWriteSalesRecord(resource.data) && resource.data.get("stripeSubscriptionId", "") in ["", null]
        && resource.data.get("checkoutHold", false) != true
        && (resource.data.get("checkoutCancellationRequested", false) != true || resource.data.get("checkoutCancellationStatus", "") == "complete");
    }

    match /salesInvoices/{invoiceId} {
      allow read: if canReadSalesRecord(resource.data);
      allow create: if canCompanyWriteSalesRecord(request.resource.data) && validUnpaidSalesInvoice(request.resource.data, invoiceId);
      allow update, delete: if false;
    }

    match /salesPayments/{paymentId} {
      allow read: if canReadSalesRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /salesPaymentEvents/{paymentEventId} {
      allow read: if canReadSalesRecord(resource.data);
      allow create, update: if false;
      allow delete: if false;
    }

    match /salesInvoiceEvents/{eventId} {
      allow read: if signedIn() && canReadCompanyBilling(resource.data.companyId);
      allow write: if false;
    }

    match /salesPaymentAdjustments/{adjustmentId} {
      allow read: if canReadSalesRecord(resource.data);
      allow write: if false;
    }

    match /recurringPartCharges/{chargeId} {
      allow read: if canReadSalesRecord(resource.data);
      allow write: if false;
    }

    match /billingEmailQueue/{emailId} {
      allow read: if signedIn() && canReadCompanyBilling(resource.data.companyId);
      allow write: if false;
    }

    match /stripeSyncLocks/{lockId} { allow read, write: if false; }
    match /salesPaymentProfiles/{profileId} { allow read, write: if false; }
    match /billingReminderPolicies/{companyId} { allow read, write: if false; }
    match /stripeSyncEvents/{eventId} { allow read, write: if false; }

    match /customerPartApprovals/{approvalId} {
      allow read: if canReadSalesRecord(resource.data);
      allow create: if canCompanyWriteSalesRecord(request.resource.data);
      allow update: if canCompanyWriteSalesRecord(resource.data) && preservesSalesIdentity();
      allow delete: if canCompanyWriteSalesRecord(resource.data);
    }

    match /subscriptions/{subscriptionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /universal/equipment/equipmentTypes/{typeId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isDripDropAdmin();
    }

    match /universal/equipment/equipmentMakes/{makeId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isDripDropAdmin();
    }

    match /universal/equipment/equipment/{equipmentId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isDripDropAdmin();

      match /parts/{partId} {
        allow get, list: if signedIn();
        allow create, update, delete: if isDripDropAdmin();
      }
    }

    match /universal/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isDripDropAdmin();
    }

    match /universalEquipmentSuggestions/{suggestionId} {
      allow create: if signedIn()
        && request.resource.data.companyId is string
        && hasCompanyAccess(request.resource.data.companyId)
        && request.resource.data.status == "New";
      allow get, list: if isDripDropAdmin()
        || (
          resource.data.companyId is string
          && hasCompanyAccess(resource.data.companyId)
        );
      allow update: if isDripDropAdmin()
        || (
          resource.data.companyId is string
          && hasCompanyAccess(resource.data.companyId)
          && request.resource.data.companyId == resource.data.companyId
        );
      allow delete: if isDripDropAdmin();
    }

    match /featureFlags/{flagId} {
      allow get: if flagId == "feature_flag_000" || signedIn();
      allow list: if signedIn();
      allow create, update, delete: if isDripDropAdmin();
    }

    match /productFeedback/{feedbackId} {
      allow create: if validProductFeedbackCreate(request.resource.data) || isDripDropAdmin();
      allow read, update, delete: if isDripDropAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if validContactMessageCreate(request.resource.data) || isDripDropAdmin();
      allow read, update, delete: if isDripDropAdmin();
    }

    match /appErrors/{errorId} {
      allow create: if validAppErrorCreate(request.resource.data) || isDripDropAdmin();
      allow read, update, delete: if isDripDropAdmin();
    }

    match /poolProspectLists/{listId} {
      allow read, create, update, delete: if isDripDropAdmin();

      match /{document=**} {
        allow read, create, update, delete: if isDripDropAdmin();
      }
    }

    match /{document=**} {
      allow read: if isSuperMaster();
      allow write: if isSuperMaster() && !(request.path[3] in ["salesAgreements", "salesInvoices", "salesBillingProfiles", "salesBillingSubscriptions", "salesPayments", "salesPaymentProfiles", "salesPaymentEvents", "salesInvoiceEvents", "salesPaymentAdjustments", "billingEmailQueue", "billingReminderPolicies", "recurringPartCharges", "stripeSyncLocks", "stripeSyncEvents", "customerPartApprovals"])
        && !(request.path[3] == "companies" && request.path == companyPath(request.path[4]) && !preservesStripeBillingFields())
        && !(request.path[3] == "companies" && request.path != companyPath(request.path[4]) && request.path[5] in ["subscriptions", "checkoutAttempts", "stripePayouts", "stripeBalanceTransactions"]);
    }
  }
}
