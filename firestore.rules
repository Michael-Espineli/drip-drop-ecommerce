rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSuperMaster() {
      return signedIn()
        && request.auth.uid == "yRV5Ie18rrUSxT6UkWctPc99lMJ2";
    }

    function isDripDropAdmin() {
      return signedIn()
        && (
          isSuperMaster()
          || request.auth.token.admin == true

        );
    }

    function appLaunchEnabled() {
      return get(/databases/$(database)/documents/featureFlags/feature_flag_000).data.enabled == true;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userAccessPath(companyId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/userAccess/$(companyId);
    }

    function companyPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId);
    }

    function isCompanyOwner(companyId) {
      return signedIn()
        && companyId is string
        && get(companyPath(companyId)) != null
        && get(companyPath(companyId)).data.ownerId == request.auth.uid;
    }

    function activeStatus(value) {
      return value == null || (value is string && !value.lower().matches(" *(inactive|revoked|past|deleted|declined|pending|invited|rejected|canceled|cancelled|expired) *"));
    }
    function activeCompanyMembership(companyId) {
      let data = get(userAccessPath(companyId));
      return data != null && data.data.get("active", true) != false && data.data.get("isActive", true) != false
        && data.data.get("accessActive", true) != false && data.data.get("revoked", false) != true
        && activeStatus(data.data.get("status", "")) && activeStatus(data.data.get("userStatus", ""))
        && activeStatus(data.data.get("companyUserStatus", "")) && activeStatus(data.data.get("accessStatus", ""))
        && activeStatus(data.data.get("userAccessStatus", ""));
    }
    function companyPermission(companyId, permissionId) {
      let access = get(userAccessPath(companyId));
      let roleId = access == null ? "" : access.data.get("roleId", "");
      let role = roleId is string && roleId != "" ? get(/databases/$(database)/documents/companies/$(companyId)/roles/$(roleId)) : null;
      return hasCompanyAccess(companyId) && (isCompanyOwner(companyId)
        || (access != null && role != null && role.data.get("permissionIdList", null) is list
          && role.data.get("name", "").lower() == access.data.get("roleName", "").lower()
          && role.data.get("name", "").lower() in ["owner", "admin", "manager"])
        || (role != null && role.data.get("permissionIdList", null) is list && (permissionId in role.data.permissionIdList || (permissionId == "860" && role.data.permissionIdList.hasAny(["862", "864", "866"])) )));
    }
    function hasCompanyAccess(companyId) {
      return signedIn()
        && companyId is string
        && companyId.size() > 0
        && (
          activeCompanyMembership(companyId)
          || isCompanyOwner(companyId)
        );
    }

    function isCompanyAdmin(companyId) {
      let access = get(userAccessPath(companyId));
      let roleId = access == null ? "" : access.data.get("roleId", "");
      let role = roleId is string && roleId != "" ? get(/databases/$(database)/documents/companies/$(companyId)/roles/$(roleId)) : null;
      return signedIn() && (isCompanyOwner(companyId) || (activeCompanyMembership(companyId)
        && role != null && role.data.get("permissionIdList", null) is list
        && role.data.get("name", "").lower() == access.data.get("roleName", "").lower()
        && role.data.get("name", "").lower() in ["owner", "admin", "manager"]));
    }

    function companyRolePath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId)/roles/$(get(userAccessPath(companyId)).data.roleId);
    }

    function hasCompanyRolePermission(companyId, permissionId) {
      return hasCompanyAccess(companyId)
        && get(userAccessPath(companyId)) != null
        && get(userAccessPath(companyId)).data.get("roleId", "") != ""
        && get(userAccessPath(companyId)).data.roleId is string
        && get(companyRolePath(companyId)) != null
        && (
          get(companyRolePath(companyId)).data.get("permissionIdList", []) is list
          && permissionId in get(companyRolePath(companyId)).data.get("permissionIdList", [])
        );
    }

    function canReadCompanyUserPerformanceReviews(companyId) {
      return companyPermission(companyId, "268");
    }

    function canWriteCompanyUserPerformanceReviews(companyId) {
      return companyPermission(companyId, "274");
    }

    function canReadOwnVisiblePerformanceReview(companyId, companyUserId) {
      return hasCompanyAccess(companyId)
        && resource.data.companyUserId == companyUserId
        && resource.data.technicianUserId == request.auth.uid
        && resource.data.visibleToTechnician == true;
    }

    function isPersonalOrCompanyData(data) {
      return signedIn() && (
        data.get('userId', '') == request.auth.uid
        || data.get('ownerId', '') == request.auth.uid
        || data.get('clientId', '') == request.auth.uid
        || data.get('customerUserId', '') == request.auth.uid
        || data.get('homeownerId', '') == request.auth.uid
        || data.get('homeownerUserId', '') == request.auth.uid
        || hasCompanyAccess(data.get('companyId', ''))
        || hasCompanyAccess(data.get('linkedCompanyId', ''))
        || hasCompanyAccess(data.get('senderId', ''))
        || hasCompanyAccess(data.get('receiverId', ''))
      );
    }

    function emailMatchesSignedInUser(data) {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') != ''
        && (
          data.get('email', '') == request.auth.token.email
          || data.get('customerEmail', '') == request.auth.token.email
          || data.get('billingEmail', '') == request.auth.token.email
        );
    }

    function hasLinkedSalesCustomerUser(data) {
      return data.get('customerUserId', '') is string && data.get('customerUserId', '').size() > 0;
    }

    function preservesHomeownerIdentity() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'userId', 'homeownerId', 'homeownerUserId', 'customerUserId', 'companyId', 'linkedCompanyId',
        'relationshipId', 'customerCompanyRelationshipId', 'linkedCompanyCustomerId',
        'companyServiceLocationId', 'companyBodyOfWaterId', 'companyEquipmentId',
        'linkedCompanyServiceLocationId', 'linkedCompanyBodyOfWaterId', 'linkedCompanyEquipmentId',
        'sourceCompanyServiceLocationId', 'sourceCompanyBodyOfWaterId', 'sourceCompanyEquipmentId'
      ]);
    }

    function canReadSalesRecord(data) {
      return signedIn()
        && (
          (data.get('customerUserId', '') == request.auth.uid)
          || (!hasLinkedSalesCustomerUser(data) && emailMatchesSignedInUser(data))
          || (data.get('companyId', '') is string && canReadCompanyBilling(data.get('companyId', '')))
        );
    }

    function canCompanyWriteSalesRecord(data) {
      return signedIn()
        && data.companyId is string
        && canManageCompanyBilling(data.companyId);
    }

    function billingStatusActive(status) {
      return status == null || (status is string && !(status.lower() in ["inactive", "revoked", "past", "deleted", "declined", "pending", "invited", "rejected", "canceled", "cancelled", "expired"]));
    }

    function activeBillingMembership(companyId) {
      let access = get(userAccessPath(companyId));
      return access != null
        && access.data.get("active", true) != false && access.data.get("isActive", true) != false
        && access.data.get("accessActive", true) != false
        && access.data.get("revoked", false) != true
        && billingStatusActive(access.data.get("status", ""))
        && billingStatusActive(access.data.get("userStatus", ""))
        && billingStatusActive(access.data.get("companyUserStatus", ""))
        && billingStatusActive(access.data.get("accessStatus", ""))
        && billingStatusActive(access.data.get("userAccessStatus", ""));
    }

    function companyBillingPermission(companyId, permissions) {
      let access = get(userAccessPath(companyId));
      let roleId = access == null ? "" : access.data.get("roleId", "");
      let role = roleId is string && roleId != "" ? get(/databases/$(database)/documents/companies/$(companyId)/roles/$(roleId)) : null;
      return signedIn() && (isCompanyOwner(companyId) || (activeCompanyMembership(companyId)
        && access != null && role != null && role.data.get("permissionIdList", null) is list
        && ((role.data.get("name", "").lower() == access.data.get("roleName", "").lower()
            && role.data.get("name", "").lower() in ["owner", "admin", "manager"])
          || role.data.permissionIdList.hasAny(permissions))));
    }

    function canManageCompanyBilling(companyId) { return companyBillingPermission(companyId, ["404"]); }
    function canReadCompanyBilling(companyId) { return companyBillingPermission(companyId, ["400", "404"]); }

    function preservesSalesIdentity() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "id", "companyId", "customerId", "customerUserId", "relationshipId", "customerCompanyRelationshipId",
        "billingProfileId", "billingSubscriptionId", "agreementId", "jobId"
      ]);
    }

    function preservesStripeBillingFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "stripeConnectedAccountId", "stripeConnectAccountId", "stripeCustomerId", "stripeSubscriptionId", "stripeSubscriptionItemId",
        "stripeInvoiceId", "stripePaymentIntentId", "stripeChargeId", "stripeStatus", "checkoutSessionId", "checkoutUrl", "checkoutStatus",
        "autopayEnabled", "autopayStatus", "billingCollectionMethod", "manualBillingEnabled", "stripeSyncedAt",
        "stripeId", "checkoutAttemptId", "checkoutVersion", "checkoutHold", "checkoutCustomerData", "firstAutomaticChargeAt",
        "billingReviewRequired", "billingReviewReason", "duplicateStripeSubscriptionIds", "stripePricingSnapshotHash",
        "checkoutCancellationRequested", "checkoutCancellationHadSetup", "checkoutCancellationId", "checkoutCancellationStatus", "checkoutCancellationRequestedAt",
        "cancellationPaymentReviewRequired", "billingEndAt", "stripeCancelAt"
      ]);
    }

    function validUnpaidSalesInvoice(data, invoiceId) {
      return data.get("id", invoiceId) == invoiceId
        && data.get("status", "draft") in ["draft", "open", "overdue"]
        && data.get("totalAmountCents", -1) is int && data.totalAmountCents >= 0
        && data.get("amountPaidCents", 0) == 0 && data.get("writeOffAmountCents", 0) == 0
        && data.get("creditAmountCents", 0) == 0 && data.get("stripeCreditAmountCents", 0) == 0
        && data.get("refundCreditCents", 0) == 0 && data.get("disputeCreditCents", 0) == 0
        && data.get("amountDueCents", -1) == data.totalAmountCents
        && data.get("stripeInvoiceId", "") in ["", null]
        && data.get("stripePaymentIntentId", "") in ["", null]
        && data.get("stripeChargeId", "") in ["", null]
        && data.get("stripeHostedInvoiceUrl", "") in ["", null]
        && data.get("billingSubscriptionId", "") in ["", null]
        && data.get("paidAt", null) == null && data.get("lastPaymentAt", null) == null
        && !data.keys().hasAny(["billingMutation", "portalPaymentAttemptId", "portalPaymentAttemptVersion", "officePaymentAttemptId", "stripeInvoiceMutation", "externalPaymentDetails", "collectionReminderState", "collectionReminderCount", "lastCollectionReminderAt", "lastPaymentId", "paymentProcessing", "billingRevision"]);
    }

    function canUseCompanySalesAgreementPermission(companyId, permissionId) {
      return isCompanyOwner(companyId)
        || hasCompanyRolePermission(companyId, permissionId)
        || canManageCompanyBilling(companyId);
    }

    function canReadSalesAgreementRecord(data) {
      return signedIn()
        && (
          (data.get('customerUserId', '') == request.auth.uid)
          || (!hasLinkedSalesCustomerUser(data) && emailMatchesSignedInUser(data))
          || (
            data.get('companyId', '') is string
            && hasCompanyAccess(data.get('companyId', ''))
            && (
              canUseCompanySalesAgreementPermission(data.companyId, "430")
              || canUseCompanySalesAgreementPermission(data.companyId, "628")
              || canReadCompanyBilling(data.companyId)
            )
          )
        );
    }

    function canCreateSalesAgreementRecord(data) {
      return signedIn()
        && data.companyId is string
        && hasCompanyAccess(data.companyId)
        && (
          canUseCompanySalesAgreementPermission(data.companyId, "432")
          || canUseCompanySalesAgreementPermission(data.companyId, "628")
        );
    }

    function canUpdateSalesAgreementRecord(data) {
      return signedIn()
        && data.companyId is string
        && hasCompanyAccess(data.companyId)
        && canUseCompanySalesAgreementPermission(data.companyId, "434");
    }

    function canDeleteSalesAgreementRecord(data) {
      return signedIn()
        && data.companyId is string
        && hasCompanyAccess(data.companyId)
        && canUseCompanySalesAgreementPermission(data.companyId, "436");
    }

    function validProductFeedbackCreate(data) {
      return data.keys().hasOnly([
          "type",
          "typeLabel",
          "audience",
          "title",
          "description",
          "priority",
          "requesterName",
          "requesterEmail",
          "status",
          "source",
          "userId",
          "userEmail",
          "accountType",
          "companyId",
          "companyName",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasAll(["type", "title", "description", "status", "source", "createdAt", "updatedAt"])
        && data.type in ["bug", "feature"]
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 5000
        && data.status == "New"
        && data.source == "footer"
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validContactMessageCreate(data) {
      return data.keys().hasOnly([
          "name",
          "email",
          "companyName",
          "subject",
          "message",
          "audience",
          "status",
          "source",
          "userId",
          "userEmail",
          "accountType",
          "companyId",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasAll(["name", "email", "message", "status", "source", "createdAt", "updatedAt"])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 160
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 320
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 5000
        && data.status == "New"
        && data.source in ["contact-page", "footer"]
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validAppErrorCreate(data) {
      return data.keys().hasOnly([
          "title",
          "description",
          "message",
          "where",
          "status",
          "severity",
          "source",
          "userId",
          "userEmail",
          "accountType",
          "companyId",
          "companyName",
          "location",
          "pathname",
          "data",
          "stack",
          "fingerprint",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasAll([
          "title",
          "description",
          "message",
          "where",
          "status",
          "severity",
          "source",
          "userId",
          "userEmail",
          "accountType",
          "companyId",
          "companyName",
          "location",
          "pathname",
          "data",
          "stack",
          "fingerprint",
          "createdAt",
          "updatedAt"
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 220
        && data.description is string
        && data.description.size() <= 5000
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 5000
        && data.where is string
        && data.where.size() > 0
        && data.where.size() <= 500
        && data.status == "New"
        && data.severity in ["info", "warning", "error", "critical"]
        && data.source is string
        && data.source.size() > 0
        && data.source.size() <= 100
        && data.userId is string
        && data.userId.size() <= 320
        && data.userEmail is string
        && data.userEmail.size() <= 320
        && data.accountType is string
        && data.accountType.size() <= 120
        && data.companyId is string
        && data.companyId.size() <= 320
        && data.companyName is string
        && data.companyName.size() <= 320
        && data.location is string
        && data.location.size() <= 1000
        && data.pathname is string
        && data.pathname.size() <= 500
        && data.data is string
        && data.data.size() <= 10000
        && data.stack is string
        && data.stack.size() <= 15000
        && data.fingerprint is string
        && data.fingerprint.size() <= 500
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function chatParticipant(data) {
      return signedIn()
        && request.auth.uid in data.get("participantIds", []);
    }

    function companyChatParticipant(data) {
      return signedIn() && (
        hasCompanyRolePermission(data.get("companyId", ""), "300")
        || hasCompanyRolePermission(data.get("senderCompanyId", ""), "300")
        || hasCompanyRolePermission(data.get("receiverCompanyId", ""), "300")
      );
    }

    function canReadChatData(data) {
      return chatParticipant(data) || companyChatParticipant(data);
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function canReadChatById(chatId) {
      return signedIn()
        && chatId is string
        && exists(chatPath(chatId))
        && canReadChatData(get(chatPath(chatId)).data);
    }

    function canReadChatByIdAfter(chatId) {
      return signedIn()
        && chatId is string
        && existsAfter(chatPath(chatId))
        && canReadChatData(getAfter(chatPath(chatId)).data);
    }

    function chatIncludesUserById(chatId, userId) {
      return chatId is string
        && userId is string
        && exists(chatPath(chatId))
        && get(chatPath(chatId)).data.participantIds is list
        && userId in get(chatPath(chatId)).data.participantIds;
    }

    function chatIncludesUserByIdAfter(chatId, userId) {
      return chatId is string
        && userId is string
        && existsAfter(chatPath(chatId))
        && getAfter(chatPath(chatId)).data.participantIds is list
        && userId in getAfter(chatPath(chatId)).data.participantIds;
    }

    function chatIncludesCompanyById(chatId, companyId) {
      return chatId is string
        && companyId is string
        && exists(chatPath(chatId))
        && get(chatPath(chatId)).data.participantCompanyIds is list
        && companyId in get(chatPath(chatId)).data.participantCompanyIds;
    }

    function chatIncludesCompanyByIdAfter(chatId, companyId) {
      return chatId is string
        && companyId is string
        && existsAfter(chatPath(chatId))
        && getAfter(chatPath(chatId)).data.participantCompanyIds is list
        && companyId in getAfter(chatPath(chatId)).data.participantCompanyIds;
    }

    match /users/{userId} {
      allow create: if isSelf(userId)
        && request.resource.data.id == request.auth.uid
        && request.resource.data.get("accountType", "").lower() in ["company", "seller", "technician", "tech", "employee", "contractor", "client", "homeowner", "customer"]
        && !request.resource.data.keys().hasAny(["admin", "isAdmin", "customClaims", "claims", "permissions"]);
      allow read: if isSelf(userId);
      allow update: if isSelf(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "id", "admin", "isAdmin", "customClaims", "claims", "permissions"
      ]) && (request.resource.data.get("accountType", "") == resource.data.get("accountType", "")
        || request.resource.data.get("accountType", "").lower() in ["company", "seller", "technician", "tech", "employee", "contractor", "client", "homeowner", "customer"]);
      allow delete: if false;

      match /userAccess/{accessId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if false;
      }

      match /savedCompanies/{savedCompanyId} {
        allow read, write: if isSelf(userId);
      }

      match /recentActivity/{activityId} {
        allow read, write: if isSelf(userId);
      }

      match /alerts/{alertId} {
        allow read, update, delete: if isSelf(userId);
        allow create: if isSelf(userId)
          || (
            signedIn()
            && request.resource.data.recipientUserId == userId
            && request.resource.data.chatId is string
            && (
              canReadChatById(request.resource.data.chatId)
              || canReadChatByIdAfter(request.resource.data.chatId)
            )
            && (
              chatIncludesUserById(request.resource.data.chatId, userId)
              || chatIncludesUserByIdAfter(request.resource.data.chatId, userId)
            )
          );
      }
    }

    match /companies/{companyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && appLaunchEnabled()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.get("stripeCustomerId", "") in ["", null]
        && request.resource.data.get("stripeId", "") in ["", null]
        && request.resource.data.get("stripeSubscriptionId", "") in ["", null]
        && !request.resource.data.keys().hasAny(["checkoutAttemptId", "checkoutHold", "checkoutVersion", "checkoutCustomerData"]);
      allow update: if (companyPermission(companyId, "814") || companyPermission(companyId, "900"))
        && preservesStripeBillingFields()
        && (isCompanyOwner(companyId) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["ownerId", "stripeConnectedAccountId", "stripeConnectAccountId"]))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["adminFlags", "verifiedByAdminId", "verified", "isVerified"]);
      allow delete: if false;

      match /alerts/{alertId} {
        allow create: if hasCompanyAccess(companyId)
          || (
            signedIn()
            && request.resource.data.recipientCompanyId == companyId
            && request.resource.data.chatId is string
            && request.resource.data.source == "chat"
            && (
              canReadChatById(request.resource.data.chatId)
              || canReadChatByIdAfter(request.resource.data.chatId)
            )
            && (
              chatIncludesCompanyById(request.resource.data.chatId, companyId)
              || chatIncludesCompanyByIdAfter(request.resource.data.chatId, companyId)
            )
          );
        allow read, update, delete: if hasCompanyAccess(companyId);
      }

      function permitted(id) { return companyPermission(companyId, id); }
      function assignedStop(stop) { return hasCompanyAccess(companyId) && stop.get("techId", "") == request.auth.uid; }
      function canEditJob(job) { return permitted("24") || (job != null && job.get("sourceTemplateId", "") != "" && permitted("28")); }
      function executionUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "operationStatus", "status", "completedAt", "finishedAt", "startedAt", "startTime", "endTime", "duration", "actualTime",
          "completedByUserId", "completedByUserName", "notes", "customerNotes", "description", "photoUrls", "updatedAt", "dateFinished",
          "actualDuration", "completionDate", "completionSource", "completionRequestId", "timeLogIds"
        ]);
      }
      function completionRequestFields() {
        return ["completionWorkStatus", "completionWorkRequestId", "completionWorkQueuedAt", "completionWorkQueuedByUserId", "completionWorkSendServiceReport"];
      }
      function completionWorkFields() {
        return ["id", "requestId", "companyId", "serviceStopId", "status", "queuedAt", "queuedByUserId", "sendServiceReport", "operationStatus", "serviceDate", "techId", "techName", "attempts"];
      }
      // Validate both documents after the batch, without granting client access to
      // server-owned results or permitting a standalone/replayed queue request.
      function validCompletionRequest(stopId) {
        let path = /databases/$(database)/documents/companies/$(companyId)/serviceStops/$(stopId);
        let before = get(path).data;
        let stop = getAfter(path).data;
        let work = getAfter(/databases/$(database)/documents/companies/$(companyId)/serviceStopCompletionWork/$(stopId)).data;
        return stop.operationStatus == "Finished" && stop.completionWorkStatus == "queued"
          && stop.completionWorkRequestId is string && stop.completionWorkRequestId.size() > 0 && stop.completionWorkRequestId.size() <= 200
          && stop.completionWorkRequestId != before.get("completionWorkRequestId", "")
          && stop.completionWorkQueuedAt == request.time && stop.completionWorkQueuedByUserId == request.auth.uid
          && stop.completionWorkSendServiceReport is bool
          && work.id == stopId && work.companyId == companyId && work.serviceStopId == stopId
          && work.requestId == stop.completionWorkRequestId && work.status == "queued" && work.operationStatus == "Finished"
          && work.queuedAt == request.time && work.queuedByUserId == request.auth.uid && work.attempts == 0
          && work.sendServiceReport == stop.completionWorkSendServiceReport
          && work.serviceDate == stop.serviceDate && work.techId == stop.techId && work.techName == stop.tech;
      }
      function stopCompletionUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(completionRequestFields().concat(["operationStatus", "endTime", "duration"]))
          && changed.hasAny(completionRequestFields());
      }
      function preservesCompletionResults() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "completionWorkProcessedAt", "completionWorkErrorMessages", "serviceReportLastResult",
