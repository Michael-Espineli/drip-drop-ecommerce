{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "test:job-plans": "node --test jobPlanWorkspace.test.js jobScopePricing.test.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:payroll": "node --test payrollCalculation.test.js payrollWorkflow.test.js",
    "test:technician-work": "node --test technicianWork.test.js",
    "test:workflow-rules": "node --test firestoreWorkflow.rules.test.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "@sendgrid/mail": "^8.1.5",
    "dotenv": "^17.2.3",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^7.2.2",
    "stripe": "^17.3.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
